# ClinicalAI Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env with real credentials.

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL / Supabase connection string.
# If not set, the backend falls back to a local SQLite database.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME

# For Supabase, use the transaction-mode pooler URL:
# DATABASE_URL=postgresql+asyncpg://postgres.PROJECTID:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ── Optional ──────────────────────────────────────────────────────────────────
# Set to "production" in deployment
ENVIRONMENT=development
